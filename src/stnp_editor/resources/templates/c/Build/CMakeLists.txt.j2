# Generated by STNP Editor {{ stnp_version }}. Safe to include from a parent CubeMX CMake project.
# Generated protocol/runtime sources are archived into libstnp.a.
# User Implementation sources are INTERFACE sources so the consuming application
# compiles their strong symbols directly, avoiding weak/strong archive extraction traps.

add_library(stnp STATIC
{% for name in ["stnp_core.c", "stnp_frame.c", "stnp_codec.c", "stnp_vtl.c", "stnp_task.c", "stnp_notify.c", "stnp_router.c", "stnp_runtime.c"] %}    "${CMAKE_CURRENT_LIST_DIR}/Core/{{ name }}"
{% endfor %}{% if p.crc_enabled %}    "${CMAKE_CURRENT_LIST_DIR}/Core/stnp_crc.c"
{% endif %}    "${CMAKE_CURRENT_LIST_DIR}/Module/stnp_module.c"
{% for m in ir.modules %}    "${CMAKE_CURRENT_LIST_DIR}/Module/{{ m.dir_name }}/{{ m.snake }}.c"
{% endfor %}    "${CMAKE_CURRENT_LIST_DIR}/Instance/stnp_instances.c"
{% if "stm32_hal_uart" in ir.sdks %}    "${CMAKE_CURRENT_LIST_DIR}/SDK/STM32_HAL/stnp_hal_uart.c"
{% endif %}{% if "freertos" in ir.sdks %}    "${CMAKE_CURRENT_LIST_DIR}/SDK/FreeRTOS/stnp_freertos.c"
{% endif %})

# These files intentionally do NOT enter libstnp.a. A consumer that links stnp
# compiles them as application objects, so strong user handlers/callbacks override
# generated weak fallbacks deterministically.
target_sources(stnp INTERFACE
{% for m in ir.modules %}{% if m.commands %}    "${CMAKE_CURRENT_LIST_DIR}/Implementation/{{ m.snake }}_impl.c"
{% endif %}{% endfor %}    "${CMAKE_CURRENT_LIST_DIR}/Implementation/stnp_notify_callback.c"
)

target_include_directories(stnp PUBLIC
    "${CMAKE_CURRENT_LIST_DIR}"
    "${CMAKE_CURRENT_LIST_DIR}/Platform"
    "${CMAKE_CURRENT_LIST_DIR}/Core"
    "${CMAKE_CURRENT_LIST_DIR}/Module"
    "${CMAKE_CURRENT_LIST_DIR}/Instance"
)

set_target_properties(stnp PROPERTIES
    C_STANDARD 99
    C_STANDARD_REQUIRED YES
    C_EXTENSIONS OFF
)

{% if "stm32_hal_uart" in ir.sdks or "freertos" in ir.sdks %}# Official STM32 HAL / FreeRTOS SDK headers are supplied by CubeMX's stm32cubemx target.
# Add this STNP directory after add_subdirectory(cmake/stm32cubemx) in the parent project.
if(NOT TARGET stm32cubemx)
    message(FATAL_ERROR
        "STNP: selected SDK requires target 'stm32cubemx'. "
        "Call add_subdirectory(cmake/stm32cubemx) before add_subdirectory(STNP).")
endif()
target_link_libraries(stnp PUBLIC stm32cubemx)
{% endif %}
