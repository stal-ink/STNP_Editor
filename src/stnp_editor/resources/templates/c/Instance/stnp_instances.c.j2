#include "stnp_instances.h"
#include "../Core/stnp_router.h"
#include "../Core/stnp_notify.h"
#include "../Core/stnp_debug.h"
{% for inst in ir.instances %}static {{ inst.module.handle_type }} {{ inst.handle_var }};
{% endfor %}
STNP_Result STNP_Instances_Init(void)
{
    STNP_Result result;
{% for inst in ir.instances %}    {{ inst.module.pascal }}_Init(&{{ inst.handle_var }}, STNP_INSTANCE_{{ inst.macro }}_ID);
    result = STNP_Router_Register({{ inst.module.pascal }}_AsModule(&{{ inst.handle_var }}));
    if (result != STNP_OK) return result;
{% endfor %}    return STNP_OK;
}
STNP_Result STNP_Notify_Dispatch(STNP_U8 source, STNP_U8 notify_code, STNP_U16 result, const STNP_U8 *payload, STNP_U8 length)
{
    if (STNP_NotifyDispatchReceive_IsEnabled() == 0U)
    {
        return STNP_OK;
    }
{% for inst in ir.instances %}    {% if not loop.first %}else {% endif %}if (source == STNP_INSTANCE_{{ inst.macro }}_ID)
    {
        if ({{ inst.module.notify_callback_is_enabled_fn }}() != 0U)
        {
            STNP_Result r = {{ inst.module.notify_dispatch_fn }}(&{{ inst.handle_var }}, notify_code, result, payload, length);
            if (r != STNP_ERR_COMMAND)
            {
                if (r == STNP_OK)
                {
                    STNP_BP_ON_NOTIFY();
                }
                return r;
            }
        }
    }
{% endfor %}    STNP_BP_ON_NOTIFY();
    STNP_Notify_Callback(source, notify_code, result, payload, length);
    return STNP_OK;
}
