};

typedef struct
{
    STNP_U8 cmd;
    STNP_U8 flags;
    STNP_U8 accept_code;
    STNP_U8 reject_code;
    STNP_U8 done_code;
} {{ m.pascal }}_AutoNotifyDesc;

static const {{ m.pascal }}_AutoNotifyDesc g_{{ m.snake }}_auto_notify[] =
{
{% for cmd in auto_commands %}    {
        {{ m.name }}_CMD_{{ cmd.name }},
        {{ (1 if cmd.notify_on_accept else 0) + (2 if cmd.notify_on_reject else 0) + (4 if cmd.notify_on_done else 0) }}U,
        {{ cmd.notify_on_accept.macro_name if cmd.notify_on_accept else "0U" }},
        {{ cmd.notify_on_reject.macro_name if cmd.notify_on_reject else "0U" }},
        {{ cmd.notify_on_done.macro_name if cmd.notify_on_done else "0U" }}
    }{% if not loop.last %},{% endif %}{{ "\n" }}{% endfor %}};

static const {{ m.pascal }}_AutoNotifyDesc *{{ m.pascal }}_AutoNotifyFind(STNP_U8 cmd)
{
    STNP_U16 i;
    for (i = 0U; i < (STNP_U16)(sizeof(g_{{ m.snake }}_auto_notify) / sizeof(g_{{ m.snake }}_auto_notify[0])); ++i)
    {
        if (g_{{ m.snake }}_auto_notify[i].cmd == cmd)
        {
            return &g_{{ m.snake }}_auto_notify[i];
        }
    }
    return STNP_NULL;
}

static STNP_Result {{ m.pascal }}_AutoNotifySend(
    {{ m.handle_type }} *self,
    const {{ m.pascal }}_AutoNotifyDesc *desc,
    STNP_U8 stage,
    {{ m.result_type }} result)
{
    STNP_U8 code;

    if ((desc == STNP_NULL) || ((desc->flags & stage) == 0U))
    {
        return STNP_OK;
    }

    if (stage == {{ m.name }}_AUTO_NOTIFY_ACCEPT)
    {
        code = desc->accept_code;
    }
    else if (stage == {{ m.name }}_AUTO_NOTIFY_REJECT)
    {
        code = desc->reject_code;
    }
    else
    {
        code = desc->done_code;
    }

    return STNP_Notify_Send(self->base.id, code, (STNP_U16)result, STNP_NULL);
}

