static STNP_Result {{ m.pascal }}_TaskHandler(STNP_ModuleHandle *base, STNP_U8 code, const STNP_U8 *payload, STNP_U16 length)
{
    if (length > 255U)
    {
        return STNP_ERR_LENGTH;
    }
    return {{ m.on_task_fn }}(({{ m.handle_type }} *)base, code, payload, (STNP_U8)length);
}

