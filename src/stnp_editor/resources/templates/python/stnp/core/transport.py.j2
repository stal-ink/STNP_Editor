from __future__ import annotations

from abc import ABC, abstractmethod


class Transport(ABC):
    """Minimal transport contract used by STNP Runtime."""

    @abstractmethod
    def open(self) -> None:
        raise NotImplementedError

    @abstractmethod
    def close(self) -> None:
        raise NotImplementedError

    @abstractmethod
    def read(self, size: int = 4096) -> bytes:
        raise NotImplementedError

    @abstractmethod
    def write(self, data: bytes) -> int:
        raise NotImplementedError
